---
import { contact, bookingCta, bookingHref, bookingIsExternal } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Book your next class',
  text = 'Reserve a spot online in a couple of minutes, or call and we\'ll sort it out for you. New here? Your first class is free.',
} = Astro.props;
---

<section class="cta">
  <div class="container cta__inner" data-reveal>
    <div>
      <h2 class="cta__heading">{heading}</h2>
      <p class="cta__text">{text}</p>
    </div>
    <div class="btn-row">
      <a
        href={bookingHref}
        class="btn btn--primary"
        target={bookingIsExternal ? '_blank' : undefined}
        rel={bookingIsExternal ? 'noopener noreferrer' : undefined}
      >
        {bookingCta.label}
      </a>
      <a href={contact.phoneHref} class="btn btn--ghost">Call {contact.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 70%),
      var(--surface);
    border-block: 1px solid var(--line);
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .cta__heading {
    margin-bottom: 0.4rem;
  }

  .cta__text {
    margin: 0;
    color: var(--text-muted);
    max-width: 46ch;
  }
</style>

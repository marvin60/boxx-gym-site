---
import {
  nav,
  coach,
  contact,
  bookingCta,
  bookingHref,
  bookingIsExternal,
} from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${coach.gym} — home`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__text">
        <span class="brand__name">{coach.gym}</span>
        <span class="brand__sub">{coach.tagline}</span>
      </span>
    </a>

    <!-- Tap-to-call, always visible on mobile — never hidden behind the menu -->
    <a
      href={contact.phoneHref}
      class="header-call"
      aria-label={`Call ${contact.phone}`}
    >
      <svg
        class="header-call__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      <span class="header-call__number">{contact.phone}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={bookingHref}
        class="btn btn--primary nav__cta"
        target={bookingIsExternal ? '_blank' : undefined}
        rel={bookingIsExternal ? 'noopener noreferrer' : undefined}
      >
        {bookingCta.label}
      </a>

      <!-- Repeated inside the mobile drawer, full label -->
      <a href={contact.phoneHref} class="nav__call">
        Call {contact.phone}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(13, 13, 13, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand__mark {
    width: 8px;
    height: 30px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .brand__sub {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }

  /* The tagline is the first thing to go when space is tight */
  @media (max-width: 420px) {
    .brand__sub {
      display: none;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav__link {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-block: 0.4rem;
    transition: color 0.18s ease;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--text);
  }

  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
  }

  .nav__cta {
    padding: 0.7rem 1.25rem;
    font-size: 0.8rem;
    /* Two words at 0.13em tracking — must not wrap into the nav row */
    white-space: nowrap;
  }

  /* ---------- Tap to call (mobile only) ---------- */
  .header-call {
    display: none;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    margin-right: 0.6rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent-dim);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .header-call__icon {
    width: 15px;
    height: 15px;
    color: var(--accent-hot);
    flex-shrink: 0;
  }

  /* Number itself drops on very narrow screens; the icon remains tappable */
  @media (max-width: 360px) {
    .header-call__number {
      display: none;
    }
  }

  .nav__call {
    display: none;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--line-bright);
    border-radius: var(--radius);
    cursor: pointer;
  }

  /* Hamburger drawn from one element + pseudo-elements */
  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text);
    transition: transform 0.22s ease, opacity 0.22s ease;
  }

  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    content: '';
    position: absolute;
  }

  .nav-toggle__bars::before {
    transform: translateY(-6px);
  }

  .nav-toggle__bars::after {
    transform: translateY(6px);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::before {
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::after {
    transform: rotate(-45deg);
  }

  @media (max-width: 880px) {
    .nav-toggle {
      display: flex;
    }

    .header-call {
      display: inline-flex;
    }

    .nav__call {
      display: block;
      margin-top: 0.75rem;
      padding: 0.9rem;
      border: 1px solid var(--line-bright);
      border-radius: var(--radius);
      text-align: center;
      font-family: var(--font-display);
      font-size: 0.95rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text);
    }

    .nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 1rem var(--gutter) 2rem;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      transform: translateY(-120%);
      transition: transform 0.28s cubic-bezier(0.3, 0.8, 0.3, 1);
    }

    .nav.is-open {
      transform: none;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__link {
      display: block;
      padding: 1rem 0;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--line);
    }

    .nav__link.is-active::after {
      display: none;
    }

    .nav__cta {
      margin-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });

  // Close the menu on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('is-open');
      toggle.focus();
    }
  });
</script>

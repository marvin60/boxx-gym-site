---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import FindUs from '../components/FindUs.astro';
import { coach, contact, programs, coachPhoto } from '../data/site';

/**
 * NOTE: this page previously contained an invented life story, career timeline
 * and coaching philosophy. All of it has been removed — it was placeholder
 * copy attached to a real business, which is worse than an empty page.
 *
 * TODO: see "The coach's story" in CONTENT-NEEDED.md. What's needed:
 *   - how the coach got into boxing
 *   - whether they competed, at what level, and roughly when
 *   - when and why they started coaching
 *   - when they qualified, and in what
 *   - when BOX-X opened
 *   - the principles they actually coach by (replacing `values` below)
 */

// TODO: replace with the gym's real coaching principles, in their own words.
// These four are generic and safe, but they are not yet confirmed as BOX-X's.
const values: { title: string; text: string }[] = [];
---

<Base
  title="About"
  description={`Meet ${coach.nameFormal}, USA certified boxing coach with 20+ years of experience. ${coach.gymFull} is at ${contact.address.line1} in the ${contact.address.neighborhood} neighborhood of ${contact.address.city}, ${contact.address.state}.`}
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>{coach.tagline}</h1>
      <p class="lead">
        {coach.gymFull} is a boxing and fitness gym in the {
          contact.address.neighborhood
        } neighborhood of {contact.address.city}, at {contact.address.line1}.
        We train everyone from complete beginners to experienced boxers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container bio">
      <div class="bio__portrait" data-reveal>
        {
          coachPhoto.src ? (
            <img
              class="portrait"
              src={coachPhoto.src}
              alt={coachPhoto.alt}
              width={coachPhoto.width}
              height={coachPhoto.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="portrait-placeholder" role="img" aria-label="Photo coming soon">
              <span>BOX-X</span>
              <small>Add photo at<br />public/images/coach.jpg</small>
            </div>
          )
        }
      </div>

      <div class="bio__text" data-reveal>
        <h2>Meet {coach.nameFormal}</h2>

        <p class="bio__cred">{coach.credentialLine}</p>

        <!-- TODO: this is holding copy built only from confirmed facts.
             Replace it with the coach's own story — how he got into boxing,
             whether he competed, why he coaches. See CONTENT-NEEDED.md. -->
        <p>
          {coach.nameShort} is a USA certified boxing coach with more than 20
          years of experience. He leads every program at {coach.gym} — Kids
          classes for ages 12 and under, Teens &amp; Adults classes for 13 and
          up, and one-on-one training.
        </p>
        <p>
          Boxing is a technical sport, and it's taught here as one — you'll spend
          real time on stance, guard and footwork before anything else. Most
          people who train here aren't fighters and never intend to be. They want
          to get fit without being bored, build some confidence, or give their
          kids somewhere positive to put their energy.
        </p>

        <ul class="programs">
          {programs.map((p) => <li>{p}</li>)}
        </ul>

        {
          coach.credentials.length > 0 && (
            <ul class="creds">
              {coach.credentials.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  {
    values.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">How we coach</span>
            <h2>What doesn't change</h2>
          </div>

          <div class="grid grid--2">
            {values.map((v, i) => (
              <article class="card value" data-reveal style={`transition-delay:${i * 80}ms`}>
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FindUs />

  <CallToAction
    heading="Come and see the place"
    text={`You'll find us at ${contact.address.line1} in ${contact.address.neighborhood}. Get in touch and we'll let you know when to stop by.`}
  />
</Base>

<style>
  .page-head {
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2rem, 4vw, 3rem);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 80%);
    border-bottom: 1px solid var(--line);
  }

  .page-head h1 {
    max-width: 20ch;
  }

  .bio {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 880px) {
    .bio {
      grid-template-columns: 1fr;
    }
  }

  .bio__portrait {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  @media (max-width: 880px) {
    .bio__portrait {
      position: static;
      max-width: 320px;
    }
  }

  .portrait {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: contain;
    border: 1px solid var(--line-bright);
    border-radius: var(--radius);
  }

  .portrait-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line-bright);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse at 50% 30%, rgba(255, 255, 255, 0.08), transparent 65%),
      var(--surface-2);
  }

  .portrait-placeholder span {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .portrait-placeholder small {
    font-size: 0.72rem;
    text-align: center;
    line-height: 1.6;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bio__text h2 {
    margin-bottom: 0.75rem;
  }

  .bio__cred {
    display: inline-block;
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 100px;
    background: var(--accent-dim);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text);
  }

  .bio__text p {
    color: var(--text-muted);
  }

  .programs,
  .creds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .programs li,
  .creds li {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-bright);
    border-radius: 100px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .programs li {
    border-color: var(--accent);
    color: var(--text);
  }

  .value h3 {
    margin-bottom: 0.5rem;
  }

  .value p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
